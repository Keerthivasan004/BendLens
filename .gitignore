# ==========================================
# 🔒 BendLens - Production .gitignore Rules
# ==========================================

# 1. Confidential Files & Environment Secrets
.env
.env*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*id_rsa*
*.pub
credentials.json
secrets.json
service-account*.json
*.token
.aws/
.ssh/

# 2. Local User Scan Data & History (Zero Data Leakage)
.bendlens_history.json
.temp_scans/
temp_uploads/
temp_clones/
.bendlens/
*.lnk

# 3. Dependencies
node_modules/
.pnp
.pnp.js

# 4. Next.js Build Outputs & Cache
.next/
out/
build/
dist/
dist-electron/

# 5. Compiled Executables & Generated Downloads
*.exe
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.msi
public/downloads/

# 6. Debug Logs & System Runtime Artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
*.log
logs/

# 7. OS & IDE Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Local Database Binary Dumps (Except Sample Fixtures)
*.sqlite3
*.sqlite
*.db
!sample_project/**
