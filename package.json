{
  "name": "bendlens-platform",
  "version": "1.1.17",
  "description": "BendLens - Universal Backend Architecture & Blast Platform",
  "author": "BendLens Team",
  "packageManager": "pnpm@9.15.9",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "desktop": "electron .",
    "desktop:run": "dotnet run --project desktop/BendLens.Desktop.csproj",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "launch": "node scripts/launch-desktop.js",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.bendlens.studio",
    "productName": "BendLens",
    "asar": false,
    "asarUnpack": [
    "public/icon.ico",
    "public/icon.png",
    "node_modules/asar/**/*"
  ],
    "files": [
      "package.json",
      "next.config.js",
      ".next/**/*",
      "!**/.next/cache/**",
      "public/**/*",
      "!public/downloads/**",
      "electron/**/*",
      "sample_project/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/.cache/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "icon.ico",
          "icon.png",
          "icon.svg"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "BendLens-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BendLens",
      "uninstallDisplayName": "BendLens - Uninstall",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "include": "scripts/installer.nsh",
      "warningsAsErrors": false,
      "artifactName": "BendLens-Setup-${version}.${ext}",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "license": "LICENSE",
      "installerHeaderIcon": "public/icon.ico",
      "installerSidebar": "public/icon.ico"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "asar": "^3.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^16.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.1",
    "electron-builder": "^26.7.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}