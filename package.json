{
  "name": "bendlens-platform",
  "version": "1.0.0",
  "description": "BendLens - Universal Backend Architecture & Blast Platform",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "desktop": "electron .",
    "launch": "node scripts/launch-desktop.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.bendlens.studio",
    "productName": "BendLens",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable", "nsis"],
      "icon": "public/icon.svg"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "BendLens"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^16.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.1",
    "electron-builder": "^26.7.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
