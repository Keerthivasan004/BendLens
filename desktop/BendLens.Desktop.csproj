<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\public\icon.ico</ApplicationIcon>
    <AssemblyName>BendLens</AssemblyName>
    <RootNamespace>BendLens.Desktop</RootNamespace>
    <Version>1.1.16</Version>
    <Authors>BendLens Team</Authors>
    <Company>BendLens</Company>
    <Product>BendLens Studio</Product>
    <Description>Universal Backend Architecture &amp; Blast Platform</Description>

    <!-- Single-File Publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
